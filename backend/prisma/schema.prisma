// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())

  ownerWorkspaces      Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMembers[]
  projects             Project[]          @relation("ProjectCreator")

  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")

  comments Comment[] @relation("commentor")
  activity  Activity[]    @relation("useract")
}

model Workspace {
  id       Int                @id @default(autoincrement())
  name     String
  ownerId  Int
  owner    User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members  WorkspaceMembers[]
  deletedAt DateTime?
  projects Project[]
  activity  Activity[]     @relation("workspaceact")
}

model WorkspaceMembers {
  workspaceId Int
  userId      Int
  role        Role      @default(MEMBER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String
  status      ProjectStatus @default(PLANNING)
  workspaceId Int
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  createdById Int
  createdBy   User          @relation("ProjectCreator", fields: [createdById], references: [id])
  deletedAt   DateTime?

  tasks Task[]            @relation("TaskCreator")
  activity  Activity[]    @relation("projectact")
  @@index([workspaceId])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Task {
  id          Int    @id @default(autoincrement())
  title       String
  description String?

  status   Status     @default(TODO)
  priority Priority @default(MEDIUM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  dueDate   DateTime?

  projectId   Int
  createdById Int
  assigneeId  Int?

  project   Project @relation( "TaskCreator",fields: [projectId], references: [id],onDelete:Cascade)
  createdBy User    @relation("TaskCreator", fields: [createdById], references: [id])
  assignee  User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  comments Comment[] @relation("taskscomment")
  activity  Activity[]     @relation("taskact")

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

enum Status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority{
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Comment{
    id Int @id @default(autoincrement())
    content String
    taskId Int
    userId Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?

    task Task  @relation("taskscomment",fields:[taskId], references :[id], onDelete:Cascade)
    user User  @relation("commentor",fields:[userId],references:[id], onDelete:Cascade)

  }

model Activity{
    id          Int      @id @default(autoincrement())
    type        ActivityType

    workspaceId Int
    userId      Int

    taskId      Int?
    projectId   Int?

    metadata    Json?

    createdAt   DateTime @default(now())

    workspace Workspace @relation("workspaceact",fields: [workspaceId], references: [id])
    user      User      @relation("useract",fields: [userId], references: [id])
    task       Task?    @relation("taskact",fields: [taskId], references: [id])
    project    Project? @relation("projectact",fields: [projectId], references: [id])

    @@index([workspaceId])
    @@index([userId])
    @@index([createdAt])
}
enum ActivityType {
    TASK_CREATED
    TASK_UPDATED
    TASK_DELETED

    TASK_ASSIGNED
    TASK_STATUS_CHANGED

    COMMENT_CREATED
    COMMENT_UPDATED
    COMMENT_DELETED

    PROJECT_CREATED
    PROJECT_UPDATED
    PROJECT_DELETED
}
